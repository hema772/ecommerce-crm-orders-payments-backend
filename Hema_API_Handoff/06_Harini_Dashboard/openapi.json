{
  "openapi": "3.0.3",
  "info": {
    "title": "E-Commerce CRM Orders, Payments & Returns API",
    "version": "1.0.0",
    "description": "\n### E-Commerce CRM Backend - Phase 1 (Orders, Payments & Returns/Refunds)\n\n#### Key Architectural Principles\n- **Money Handling**: All amounts are strictly non-negative **integer paise** (1 INR = 100 paise). Floating points are prohibited.\n- **State Machine**: Order progression follows:\n  `PLACED` → `CONFIRMED` → `PROCESSING` → `PACKED` → `SHIPPED` → `OUT_FOR_DELIVERY` → `DELIVERED`.\n  Cancellation is permitted only before `SHIPPED` status.\n- **Envelope Response**: Every endpoint conforms to:\n  ```json\n  {\n    \"success\": true,\n    \"message\": \"Human readable message\",\n    \"data\": { ... },\n    \"pagination\": { ... } // optional\n  }\n  ```\n- **Authentication**: JWT Bearer token in `Authorization` header.\n- **RBAC**: Enforced via permission keys (`orders.read`, `orders.create`, `orders.update_status`, `orders.cancel`, etc.).\n      ",
    "contact": {
      "name": "CRM Backend Engineering Team"
    }
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Local Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Enter your JWT token to authorize."
      }
    },
    "schemas": {
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string",
            "example": "Validation failed"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "example": [
              {
                "field": "items",
                "message": "Order must contain at least one item"
              }
            ]
          }
        }
      }
    }
  },
  "paths": {
    "/api/v1/returns": {
      "post": {
        "summary": "Submit a return request",
        "description": "Creates a return request for a delivered order. Validates return window (7 days), checks quantities against delivered items, uploads evidence to Cloudinary, and checks for duplicate open returns.",
        "tags": [
          "Returns"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "orderId",
                  "items",
                  "reason"
                ],
                "properties": {
                  "orderId": {
                    "type": "string",
                    "example": "ORD-20261112-9A4F32"
                  },
                  "items": {
                    "type": "string",
                    "description": "JSON stringified array of items to return [{ product, qty, reason }]",
                    "example": "[{\"product\":\"prod_101\",\"qty\":1,\"reason\":\"Size too small\"}]"
                  },
                  "reason": {
                    "type": "string",
                    "example": "Incorrect fit and defective stitching"
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    },
                    "description": "Up to 5 image/pdf evidence files (max 5MB each)"
                  }
                }
              }
            },
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "orderId",
                  "items",
                  "reason"
                ],
                "properties": {
                  "orderId": {
                    "type": "string",
                    "example": "ORD-20261112-9A4F32"
                  },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "product",
                        "qty",
                        "reason"
                      ],
                      "properties": {
                        "product": {
                          "type": "string",
                          "example": "prod_101"
                        },
                        "qty": {
                          "type": "integer",
                          "example": 1
                        },
                        "reason": {
                          "type": "string",
                          "example": "Defective stitching"
                        }
                      }
                    }
                  },
                  "reason": {
                    "type": "string",
                    "example": "Item arrived damaged"
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "example": [
                      "https://res.cloudinary.com/demo/image/upload/sample.jpg"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Return request initiated successfully"
          },
          "400": {
            "description": "Order not delivered, return window expired, or quantity exceeded"
          },
          "403": {
            "description": "Forbidden - requires 'returns.create'"
          }
        }
      },
      "get": {
        "summary": "List return requests",
        "description": "Retrieve paginated list of return requests with status and date filters.",
        "tags": [
          "Returns"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "default": 10
            }
          },
          {
            "in": "query",
            "name": "status",
            "schema": {
              "type": "string",
              "enum": [
                "REQUESTED",
                "APPROVED",
                "PICKUP_SCHEDULED",
                "RECEIVED",
                "INSPECTED",
                "REFUNDED",
                "REJECTED"
              ]
            }
          },
          {
            "in": "query",
            "name": "orderId",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of returns"
          },
          "403": {
            "description": "Forbidden - requires 'returns.read'"
          }
        }
      }
    },
    "/api/v1/returns/{id}": {
      "get": {
        "summary": "Get single return request",
        "tags": [
          "Returns"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Return record details"
          },
          "404": {
            "description": "Return not found"
          }
        }
      }
    },
    "/api/v1/returns/{id}/approve": {
      "patch": {
        "summary": "Approve a return request (Authorization step)",
        "description": "Separately authorizes a return request prior to pickup and refund execution.",
        "tags": [
          "Returns"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "decisionNote": {
                    "type": "string",
                    "example": "Approved for reverse pickup"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Return approved"
          },
          "400": {
            "description": "Return not in REQUESTED status"
          },
          "403": {
            "description": "Forbidden - requires 'returns.approve'"
          }
        }
      }
    },
    "/api/v1/returns/{id}/reject": {
      "patch": {
        "summary": "Reject a return request",
        "description": "Rejects a return request with a mandatory rejection reason note.",
        "tags": [
          "Returns"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "decisionNote"
                ],
                "properties": {
                  "decisionNote": {
                    "type": "string",
                    "example": "Item damaged by customer misuse, ineligible for return"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Return rejected"
          },
          "400": {
            "description": "Return cannot be rejected from current state"
          },
          "403": {
            "description": "Forbidden - requires 'returns.approve'"
          }
        }
      }
    },
    "/api/v1/returns/{id}/status": {
      "patch": {
        "summary": "Advance return status along state machine",
        "description": "Moves return along REQUESTED -> APPROVED -> PICKUP_SCHEDULED -> RECEIVED -> INSPECTED -> REFUNDED. Restocks inventory upon RECEIVED or INSPECTED.",
        "tags": [
          "Returns"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "APPROVED",
                      "PICKUP_SCHEDULED",
                      "RECEIVED",
                      "INSPECTED",
                      "REFUNDED",
                      "REJECTED"
                    ]
                  },
                  "note": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Return status updated"
          },
          "400": {
            "description": "Invalid status transition"
          },
          "403": {
            "description": "Forbidden - requires 'returns.approve'"
          }
        }
      }
    },
    "/api/v1/refunds": {
      "post": {
        "summary": "Create a pending refund record",
        "description": "Creates a PENDING refund record for an inspected return or cancelled paid order. Validates amount against refundable balance.",
        "tags": [
          "Refunds"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "orderId": {
                    "type": "string",
                    "example": "ORD-20261112-9A4F32"
                  },
                  "returnId": {
                    "type": "string",
                    "example": "6733a41b8a59cb84a92d4f20"
                  },
                  "amount": {
                    "type": "integer",
                    "description": "Amount in paise",
                    "example": 79900
                  },
                  "notes": {
                    "type": "string",
                    "example": "Approved customer refund after inspection"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pending refund created"
          },
          "400": {
            "description": "Amount exceeds refundable balance"
          },
          "403": {
            "description": "Forbidden - requires 'refunds.approve'"
          }
        }
      },
      "get": {
        "summary": "List all refund records",
        "description": "Retrieve paginated refund transactions with status, order, and date filters.",
        "tags": [
          "Refunds"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "default": 10
            }
          },
          {
            "in": "query",
            "name": "status",
            "schema": {
              "type": "string",
              "enum": [
                "PENDING",
                "PROCESSED",
                "FAILED"
              ]
            }
          },
          {
            "in": "query",
            "name": "orderId",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of refund records"
          },
          "403": {
            "description": "Forbidden - requires 'payments.read'"
          }
        }
      }
    },
    "/api/v1/refunds/{id}/process": {
      "patch": {
        "summary": "Execute refund payout through Razorpay (Separate execution step)",
        "description": "Validates refundable balance, executes refund via Razorpay gateway, records razorpayRefundId, and updates Order paymentStatus to PARTIALLY_REFUNDED or REFUNDED.",
        "tags": [
          "Refunds"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "notes": {
                    "type": "string",
                    "example": "Processed via dashboard"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Refund successfully processed via gateway"
          },
          "400": {
            "description": "Amount exceeds refundable balance"
          },
          "403": {
            "description": "Forbidden - requires 'refunds.approve'"
          },
          "404": {
            "description": "Refund record not found"
          }
        }
      }
    },
    "/api/v1/refunds/{id}": {
      "get": {
        "summary": "Get single refund record details",
        "tags": [
          "Refunds"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Refund details"
          },
          "404": {
            "description": "Refund not found"
          }
        }
      }
    },
    "/api/v1/payments/create-order": {
      "post": {
        "summary": "Initialize a Razorpay payment order",
        "description": "Creates a Razorpay Order in test mode using the SERVER-side order grandTotal. Guards against duplicate payments on already PAID orders.",
        "tags": [
          "Payments"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "orderId"
                ],
                "properties": {
                  "orderId": {
                    "type": "string",
                    "description": "Order MongoDB ID or unique orderNumber",
                    "example": "ORD-20261112-9A4F32"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Razorpay order generated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "keyId": {
                          "type": "string",
                          "example": "rzp_test_stub_key_id"
                        },
                        "razorpayOrderId": {
                          "type": "string",
                          "example": "order_RPQ1234567"
                        },
                        "amount": {
                          "type": "integer",
                          "example": 193564
                        },
                        "currency": {
                          "type": "string",
                          "example": "INR"
                        },
                        "orderNumber": {
                          "type": "string",
                          "example": "ORD-20261112-9A4F32"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Order already paid, cancelled, or invalid"
          },
          "403": {
            "description": "Forbidden - requires 'payments.create'"
          },
          "404": {
            "description": "Order not found"
          }
        }
      }
    },
    "/api/v1/payments/verify": {
      "post": {
        "summary": "Verify Razorpay payment signature",
        "description": "Verifies the HMAC-SHA256 signature returned by Razorpay Checkout. On success, transitions Payment and Order to PAID, and moves order status from PLACED to CONFIRMED.",
        "tags": [
          "Payments"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "razorpay_order_id",
                  "razorpay_payment_id",
                  "razorpay_signature"
                ],
                "properties": {
                  "razorpay_order_id": {
                    "type": "string",
                    "example": "order_RPQ1234567"
                  },
                  "razorpay_payment_id": {
                    "type": "string",
                    "example": "pay_RPQ9876543"
                  },
                  "razorpay_signature": {
                    "type": "string",
                    "example": "9a4f32e67b8123456789abcdef0123456789abcdef0123456789abcdef012345"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Payment successfully verified and order confirmed"
          },
          "400": {
            "description": "Invalid signature or amount mismatch"
          },
          "403": {
            "description": "Forbidden - requires 'payments.create'"
          },
          "404": {
            "description": "Payment record not found"
          }
        }
      }
    },
    "/api/v1/payments/reconcile": {
      "post": {
        "summary": "Reconcile pending payments with Razorpay",
        "description": "Identifies PENDING Razorpay payments older than specified minutes and resolves their true status via Razorpay API.",
        "tags": [
          "Payments"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "olderThanMinutes": {
                    "type": "integer",
                    "default": 30
                  },
                  "limit": {
                    "type": "integer",
                    "default": 50
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reconciliation summary"
          },
          "403": {
            "description": "Forbidden - requires 'payments.create' or admin"
          }
        }
      }
    },
    "/api/v1/payments": {
      "post": {
        "summary": "Record a manual/offline payment (e.g. COD or Bank Transfer)",
        "description": "Records an offline payment transaction and updates order paymentStatus accordingly.",
        "tags": [
          "Payments"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "orderId",
                  "amount",
                  "method"
                ],
                "properties": {
                  "orderId": {
                    "type": "string",
                    "example": "ORD-20261112-9A4F32"
                  },
                  "amount": {
                    "type": "integer",
                    "description": "Amount in integer paise",
                    "example": 193564
                  },
                  "method": {
                    "type": "string",
                    "enum": [
                      "COD",
                      "BANK_TRANSFER",
                      "RAZORPAY"
                    ],
                    "example": "COD"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "PENDING",
                      "PAID"
                    ],
                    "default": "PENDING"
                  },
                  "notes": {
                    "type": "string",
                    "example": "Cash collected upon delivery by courier"
                  },
                  "transactionRef": {
                    "type": "string",
                    "example": "NEFT-UTR-9876543210"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Manual payment recorded"
          },
          "400": {
            "description": "Validation error or duplicate payment"
          },
          "403": {
            "description": "Forbidden - requires 'payments.create'"
          }
        }
      },
      "get": {
        "summary": "List all payment records",
        "description": "Retrieve paginated list of payment transactions across orders with filters.",
        "tags": [
          "Payments"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "default": 10
            }
          },
          {
            "in": "query",
            "name": "status",
            "schema": {
              "type": "string",
              "enum": [
                "PENDING",
                "PAID",
                "FAILED"
              ]
            }
          },
          {
            "in": "query",
            "name": "method",
            "schema": {
              "type": "string",
              "enum": [
                "RAZORPAY",
                "COD",
                "BANK_TRANSFER"
              ]
            }
          },
          {
            "in": "query",
            "name": "orderId",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of payment records"
          },
          "403": {
            "description": "Forbidden - requires 'payments.read'"
          }
        }
      }
    },
    "/api/v1/payments/refunds": {
      "get": {
        "summary": "List all refund records",
        "description": "Retrieve list of pending or processed refunds.",
        "tags": [
          "Payments"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "List of refund records"
          },
          "403": {
            "description": "Forbidden - requires 'payments.read'"
          }
        }
      }
    },
    "/api/v1/payments/{id}": {
      "get": {
        "summary": "Get single payment record",
        "tags": [
          "Payments"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
