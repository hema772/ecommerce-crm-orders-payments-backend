                      },
                      "state": {
                        "type": "string",
                        "example": "Karnataka"
                      },
                      "postalCode": {
                        "type": "string",
                        "example": "560038"
                      },
                      "country": {
                        "type": "string",
                        "example": "India"
                      }
                    }
                  },
                  "paymentMethod": {
                    "type": "string",
                    "enum": [
                      "RAZORPAY",
                      "COD",
                      "BANK_TRANSFER"
                    ],
                    "default": "RAZORPAY"
