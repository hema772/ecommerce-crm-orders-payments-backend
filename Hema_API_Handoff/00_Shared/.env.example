# ==============================================================================
# E-Commerce CRM Environment Configuration (Template)
# Copy this file to .env and replace placeholder values with your environment keys.
# DO NOT commit real secrets, private keys, or passwords to source control.
# ==============================================================================

# Server & Runtime
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# Database Configuration
# Local MongoDB instance or Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce_crm_orders

# Security & CORS
# Comma-separated list of allowed frontend origin URLs
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

# Authentication & JWT
# Shared JWT secret key (must match Auth service / Yogesh)
JWT_SECRET=your_jwt_secret_key_min_32_characters_here
JWT_EXPIRES_IN=1d

# Razorpay Payment Gateway (Test Mode)
# Public Test Key ID is safe for teammates/frontend:
RAZORPAY_KEY_ID=rzp_test_51Ng8BqWXYZ123
# Private API Secret (Keep confidential in production):
RAZORPAY_KEY_SECRET=your_razorpay_test_secret_here
# Webhook verification secret configured in Razorpay Dashboard:
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Cloudinary (Media storage for Return Evidence Photos)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Business Rules
# Number of calendar days after delivery during which returns are accepted
RETURN_WINDOW_DAYS=7
